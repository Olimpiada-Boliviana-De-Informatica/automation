[Unit]
Description=CMS resource service
Documentation=https://cms.readthedocs.io/en/latest/Introduction.html#services
Wants=cms-log.service
After=postgresql.service nginx.service
 
[Service]
Type=simple
User=cmsuser
WorkingDirectory=/home/cmsuser/cms
Environment="SCRIPT_ARGS=-a {{ contest_id | default('ALL') }}"
ExecStart=/home/cmsuser/cms/bin/cmsResourceService $SCRIPT_ARGS
LimitNOFILE=100000

[Install]
WantedBy=basic.target
